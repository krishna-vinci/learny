# Studium environment. Copy to `.env` and fill in. Never commit `.env`.

# Study tree location on disk (a git repo the app auto-commits to).
STUDIUM_STUDY_ROOT=./data/study
# Platform data directory (SQLite accounts database and instance secret).
STUDIUM_DATA_DIR=./data

# HTTP bind address and port. First-time setup on a non-loopback host requires the
# one-time setup code printed by the server.
HOST=127.0.0.1
PORT=3000

# Optional 32+ character instance secret. If unset, data/.secret is generated mode 0600.
STUDIUM_SECRET=

# Legacy login, migrated once into the first ADMIN account. Generate the hash with:
# pnpm --filter @studium/server hash-password
STUDIUM_USERNAME=
STUDIUM_PASSWORD_HASH=
# Legacy secret fallback; use STUDIUM_SECRET for new installations.
STUDIUM_SESSION_SECRET=
# STUDIUM_API_TOKEN is retired; create a personal access token in account settings.
# Trust proxy forwarding headers only when set to 1 or true.
STUDIUM_TRUST_PROXY=
# Public base URL; an https:// URL marks session cookies Secure.
STUDIUM_BASE_URL=

# AnkiConnect endpoint for POST /api/sets/:set/anki/sync (desktop Anki). Unset disables sync.
# ANKICONNECT_URL=http://127.0.0.1:8765

# Use the built-in fake model instead of a real provider (dev/verification only).
STUDIUM_FAUX=1

# Provider keys, read by Pi from the environment.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# ---- Research services (all optional; each one missing just disables that feature) ----

# SearXNG for web search (used through the searxng MCP server).
# SEARXNG_URL=https://search.example.com

# Remote paper-search MCP server (Streamable HTTP). The token is only needed if your
# server checks a bearer token; path-secret URLs work without it.
# PAPERS_MCP_URL=https://papers.example.com/mcp
# PAPERS_MCP_TOKEN=

# Firecrawl for JS-heavy pages (ingest + the agents' web_fetch tool), v2 API.
# Self-hosted (docker compose, no auth): FIRECRAWL_API_URL=http://127.0.0.1:3002 and leave
# the key empty. Cloud: FIRECRAWL_API_URL=https://api.firecrawl.dev with FIRECRAWL_API_KEY=fc-...
# Put each value on its own line with no trailing "# comment".
# FIRECRAWL_API_URL=http://127.0.0.1:3002
# FIRECRAWL_API_KEY=

# MinerU for high-quality PDF parsing (formulas, tables). Unset = built-in PDF text extraction.
# MINERU_URL=http://127.0.0.1:8000

# Context7 MCP (up-to-date library/API docs for agents). Optional: works without a key at
# lower rate limits; a free key comes from https://context7.com/dashboard.
# CONTEXT7_API_KEY=

# ---- Runtime ----
# Parallel agent jobs per user (default 3).
# STUDIUM_MAX_PARALLEL_JOBS=3
# Pi config dir holding provider logins (auth.json / models.json). Default ~/.pi/agent.
# PI_CODING_AGENT_DIR=

# Optional classifier (M10): configure models.classifier in workspace YAML; off without this key.
# OPENCODE_API_KEY=
