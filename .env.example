# Studium environment. Copy to .env; never commit filled credentials.
# Required: none for first boot. Setup creates the admin and instance secret.
# For real AI jobs: configure at least one provider below, then choose it in Settings.

# ---- Instance / native install defaults (Compose overrides these five) ----
STUDIUM_DATA_DIR=./data
STUDIUM_STUDY_ROOT=./data/study
HOST=127.0.0.1
PORT=3000
# Pi provider credentials and custom models. Container path is /pi-agent.
# PI_CODING_AGENT_DIR=/path/to/pi-agent
# Optional public HTTPS URL enables Secure cookies; set for a reverse proxy.
# STUDIUM_BASE_URL=https://studium.example.com
# Optional; 1/true only behind a proxy that overwrites forwarding headers.
# STUDIUM_TRUST_PROXY=1
# Optional 32+ character secret. Unset generates data/.secret (0600).
# STUDIUM_SECRET=
# Optional legacy first-admin bootstrap; normally use the setup page instead.
# Generate the hash with: pnpm --filter @studium/server hash-password
# STUDIUM_USERNAME=
# STUDIUM_PASSWORD_HASH=
# STUDIUM_SESSION_SECRET= # legacy fallback; prefer STUDIUM_SECRET
# Optional concurrency limit per user (default 3).
# STUDIUM_MAX_PARALLEL_JOBS=3
# Image sets this from its VERSION build arg; native installs default to dev.
# STUDIUM_VERSION=dev
# Development/verification only: fake model, no provider requests. Default off.
STUDIUM_FAUX=0

# ---- Model providers (optional; one credential required to use real AI) ----
# Keys are read by Pi; Settings -> Models selects models, it does not accept keys.
# Restart/recreate after changes. Subscription OAuth uses /pi-agent/auth.json;
# run Pi's /login interactively, never paste OAuth tokens in workspace config.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# XAI_API_KEY=
# ZAI_API_KEY=
# ZAI_CODING_CN_API_KEY=
# MINIMAX_API_KEY=
# MINIMAX_CN_API_KEY=
# MOONSHOT_API_KEY=
# KIMI_API_KEY=
# OPENCODE_API_KEY= # also needed for the optional classifier in workspace YAML
# NVIDIA_API_KEY=
# HF_TOKEN=
# FIREWORKS_API_KEY=
# TOGETHER_API_KEY=
# BASETEN_API_KEY=
# AI_GATEWAY_API_KEY=
# TYPESAFE_API_KEY=
# RADIUS_API_KEY=
# META_API_KEY=
# CLOUDFLARE_API_KEY=
# XIAOMI_API_KEY=
# XIAOMI_TOKEN_PLAN_CN_API_KEY=
# XIAOMI_TOKEN_PLAN_AMS_API_KEY=
# XIAOMI_TOKEN_PLAN_SGP_API_KEY=
# ANT_LING_API_KEY=
# QWEN_TOKEN_PLAN_API_KEY=
# QWEN_TOKEN_PLAN_CN_API_KEY=
# COPILOT_GITHUB_TOKEN=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_OAUTH_TOKEN=
# AZURE_OPENAI_API_KEY=
# GOOGLE_CLOUD_API_KEY=
# For provider-specific cloud/ADC settings and custom models, see Pi docs.

# ---- Search / research services (optional; absent backends are disabled) ----
# OPENVERSE_ACCESS_TOKEN= # optional image search bearer token
# SMITHSONIAN_API_KEY= # optional Smithsonian image search key
# EXA_API_KEY=
# SEARXNG_URL=https://searxng.example.com
# PAPERS_MCP_URL=https://papers.example.com/mcp
# PAPERS_MCP_TOKEN=
# CONTEXT7_API_KEY= # unkeyed Context7 may work at lower rate limits
# FIRECRAWL_API_URL=https://api.firecrawl.dev
# FIRECRAWL_API_KEY= # optional for an operator-managed self-hosted service
# A localhost URL inside Docker means the container, not the host.

# ---- PDFs (optional; absent MinerU falls back to built-in text extraction) ----
# MINERU_URL=https://mineru.example.com
# MINERU_API_KEY= # optional Bearer token
# MINERU_TIER=basic

# ---- YouTube (optional; pinned yt-dlp is included in the image) ----
# Admin Settings -> Integrations can install/update yt-dlp and store cookies.
# YTDLP_PATH=/path/to/yt-dlp
# YOUTUBE_COOKIES_PATH=/path/to/cookies.txt

# ---- Anki (optional; unset disables server-side AnkiConnect sync) ----
# ANKICONNECT_URL=http://your-anki-host:8765

# ---- Notifications / backups ----
# No app-specific environment variables: configure ntfy, Web Push and restic
# in Settings. Credentials are encrypted in the accounts DB. Backups need /data
# and its .secret together. Keep the separate pi-agent credential directory safe.

# ---- Inherited process/tool environment (normally leave unchanged) ----
# Server/tool subprocesses use PATH, HOME, TMPDIR, LANG and NO_COLOR. NODE_ENV is
# production in the image. Restic/rclone environment is generated from Settings;
# Backup subprocess env is constructed from encrypted Settings, not read as app
# configuration: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION,
# RESTIC_REST_USERNAME, RESTIC_REST_PASSWORD and RCLONE_CONFIG.
# GIT_DIR, GIT_WORK_TREE and GIT_INDEX_FILE are stripped for study-tree git calls.
# Developer scripts only: PAPERS_BAKEOFF_ROOT points at a temporary tree copy.
