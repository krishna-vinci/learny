{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "files": {
    "includes": [
      "**",
      "!reference",
      "!data",
      "!**/dist",
      "!examples",
      "!.claude",
      "!.worktrees",
      "!docs/plans",
      "!**/fixtures/**/*.html"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["skills/**/templates/**"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
