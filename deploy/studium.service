[Unit]
Description=Studium (self-hosted agent learning app)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/learny
ExecStart=/usr/bin/env pnpm --filter @studium/server start
Restart=always
RestartSec=3
Environment=NODE_ENV=production
# The app loads .env itself (no $ expansion), so it is not an EnvironmentFile here.

[Install]
WantedBy=default.target
